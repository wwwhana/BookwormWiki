# BookwormWiki Configuration
# Copy this file to .env and fill in your values

# PostgreSQL connection string (required)
# Format: postgres://user:password@host:port/database?sslmode=disable
#
# For local development (outside Docker):
# BOOKWORMWIKI_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/bookwormwiki?sslmode=disable
#
# For Docker Compose (use this with docker-compose.yml):
BOOKWORMWIKI_POSTGRES_DSN=postgres://stash:stash_dev_password@postgres:5432/stash?sslmode=disable

# Vector dimension - must match your embedding model (required)
# text-embedding-3-small: 1536
# The standard pgvector type used by BookwormWiki supports up to 2000 dimensions.
# Changing this or BOOKWORMWIKI_EMBEDDING_MODEL on restart automatically queues a full reindex.
BOOKWORMWIKI_VECTOR_DIM=1536

# Maximum results per query (required)
BOOKWORMWIKI_MAX_RESULT_SIZE=10000

# OpenAI-compatible API configuration
# API key is optional for local or internal endpoints without authentication.
# All BOOKWORMWIKI_OPENAI_* and model settings are optional. Without an embedding
# provider BookwormWiki still stores memories and searches them by keyword (trigram);
# vectors are computed once a provider is assigned in model settings.
BOOKWORMWIKI_OPENAI_API_KEY=
BOOKWORMWIKI_OPENAI_BASE_URL=https://api.openai.com/v1
# Maximum time for one provider request attempt. This prevents a dead or
# unavailable model endpoint from holding MCP calls indefinitely.
BOOKWORMWIKI_OPENAI_REQUEST_TIMEOUT=2m

# Atlas Cloud example:
# BOOKWORMWIKI_OPENAI_API_KEY=your-atlas-cloud-api-key
# BOOKWORMWIKI_OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# BOOKWORMWIKI_EMBEDDING_MODEL=text-embedding-3-small
# BOOKWORMWIKI_REASONER_MODEL=deepseek-ai/DeepSeek-V3-0324
# BOOKWORMWIKI_VECTOR_DIM=1536

# Embedding model (required)
# OpenAI: text-embedding-3-small, text-embedding-3-large
# OpenRouter: openai/text-embedding-3-small
BOOKWORMWIKI_EMBEDDING_MODEL=text-embedding-3-small

# Failed embeddings are stored as pending rows and retried in the background.
# Retries use exponential backoff from INTERVAL up to MAX_INTERVAL.
BOOKWORMWIKI_EMBEDDING_RETRY_INTERVAL=1m
BOOKWORMWIKI_EMBEDDING_RETRY_MAX_INTERVAL=1h
BOOKWORMWIKI_EMBEDDING_RETRY_BATCH_SIZE=100
# Maximum input window of the embedding model in tokens. Set it from the
# model's documentation; 0 lets BookwormWiki adapt after a context error.
BOOKWORMWIKI_EMBEDDING_CONTEXT_TOKENS=0

# Reasoning model for relationship extraction (required)
# OpenAI: gpt-4o-mini, gpt-4o
# OpenRouter: openai/gpt-4o-mini, google/gemma-4-26b-a4b-it
BOOKWORMWIKI_REASONER_MODEL=gpt-4o-mini
# Full context window of the reasoning model. MCP cannot discover this value.
# BookwormWiki reserves the second value for instructions and the JSON answer, then
# splits consolidation evidence before calling the model.
BOOKWORMWIKI_REASONER_CONTEXT_TOKENS=0
BOOKWORMWIKI_REASONER_RESERVED_TOKENS=4096
# Example for a 44,544-token reasoner: BOOKWORMWIKI_REASONER_CONTEXT_TOKENS=44544

# --- Ollama (fully local — see docs/LOCAL_OLLAMA.md) ---
# BOOKWORMWIKI_OPENAI_API_KEY=ollama
# BOOKWORMWIKI_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# BOOKWORMWIKI_EMBEDDING_MODEL=nomic-embed-text
# BOOKWORMWIKI_REASONER_MODEL=qwen2.5:3b
# BOOKWORMWIKI_VECTOR_DIM=768

# Memory Configuration
# Time-to-live for context (working memory windows)
# Format: 1h, 30m, 2h30m, etc.
BOOKWORMWIKI_CONTEXT_TTL=1h

# Server Configuration
# BookwormWiki server address (MCP, web console, metrics, and health checks share it)
BOOKWORMWIKI_HTTP_ADDR=127.0.0.1:8080

# Maximum JSON bytes returned by one MCP tool call. Oversized list responses
# are split and include next_offset; oversized non-list responses are omitted.
BOOKWORMWIKI_MCP_MAX_RESPONSE_BYTES=32768
# Maximum time for one MCP tool handler. Set this above the normal duration of
# your slowest model-backed operation when using a local or remote provider.
BOOKWORMWIKI_MCP_TOOL_TIMEOUT=2m

# Log level: debug, info, warn, error
# API and model-provider call records are emitted at info; ordinary web access
# records are debug-only and failures are warn. Query strings, authorization
# headers, cookies, and request bodies are never included.
BOOKWORMWIKI_LOG_LEVEL=info

# Log format: text or json
BOOKWORMWIKI_LOG_FORMAT=text

# Authentication profiles: none (local only), token (BookwormWiki API token), oauth
# (console SSO through an OIDC provider), stdio (local STDIO)
# BOOKWORMWIKI_AUTH_MODE=none  # BOOKWORMWIKI_HTTP_ADDR must stay on localhost
BOOKWORMWIKI_AUTH_MODE=token
# MCP clients always authenticate with a BookwormWiki API token stored in the
# database: issue one in the console (API tokens page) or with
# `bookwormwiki mcp token --subject <agent>`. Tokens never change on their own, so an
# agent keeps its history. The oauth profile adds SSO login for the console;
# the token profile does not contact an OIDC provider.
# SSO (OIDC) for the console. These four register the first provider: the
# server copies them into the sso_providers table at startup (sealed with
# BOOKWORMWIKI_SECRETS_KEY) and administrators manage providers in the console or
# with `bookwormwiki sso` from then on. Register the redirect URL at the issuer.
# BOOKWORMWIKI_AUTH_ISSUER=https://accounts.example.com
# BOOKWORMWIKI_AUTH_CLIENT_ID=bookwormwiki
# BOOKWORMWIKI_AUTH_CLIENT_SECRET=replace-me
# BOOKWORMWIKI_AUTH_REDIRECT_URL=https://bookwormwiki.example.com/auth/callback
BOOKWORMWIKI_AUTH_API_SECRET=
# Local HTTP uses false. Set true when the public URL uses HTTPS.
BOOKWORMWIKI_AUTH_COOKIE_SECURE=false
# Default lifetime of tokens issued by `bookwormwiki mcp token` (0 means no expiry).
# BOOKWORMWIKI_AUTH_TOKEN_TTL=720h
# Browser console session lifetime; active sessions slide forward.
# BOOKWORMWIKI_AUTH_SESSION_TTL=720h
# Optional credential for the STDIO profile. The process is trusted when it is
# empty; when set, it must be a BookwormWiki API token and is checked before using
# the user's isolated namespace.
# BOOKWORMWIKI_AUTH_STDIO_TOKEN=
# The same values may be written with the explicit BOOKWORMWIKI_AUTH_OAUTH_* prefix
# (for example BOOKWORMWIKI_AUTH_OAUTH_ISSUER); the unprefixed names take precedence.

# Optional embedding maintenance access for the web console. Set either a
# comma-separated list of stable OIDC subjects or a separate static token.
# The token is sent only as X-BookwormWiki-Admin-Token and is never used for MCP.
# BOOKWORMWIKI_ADMIN_SUBJECTS=user-1,user-2
# BOOKWORMWIKI_ADMIN_TOKEN=generate-a-long-random-maintenance-token
# First console administrator. Created at startup when the account does not
# exist; a password changed later in the console is kept. The username is the
# session subject, like an OIDC subject. Add more people with `bookwormwiki user add`.
# BOOKWORMWIKI_ADMIN_USER=admin
# BOOKWORMWIKI_ADMIN_PASSWORD=change-me-please
# With BOOKWORMWIKI_AUTH_MODE=none, allow listening beyond loopback (for example an
# OrbStack or LAN hostname). Everyone who can reach the port has full access.
# BOOKWORMWIKI_AUTH_TRUSTED_NETWORK=false

# Model providers
# Providers can also be registered in the database (console: Server settings,
# or `bookwormwiki llm provider add`) and assigned per feature. BOOKWORMWIKI_OPENAI_* stays
# the fallback for any feature without an assignment; `bookwormwiki llm import-env`
# copies it into the database. Stored API keys are sealed with this key.
# Generate once with `openssl rand -hex 32` and keep it stable.
# BOOKWORMWIKI_SECRETS_KEY=
# Comma-separated older keys that may still open existing values after rotation.
# BOOKWORMWIKI_SECRETS_KEY_PREVIOUS=
# Cache computed vectors in PostgreSQL so identical text is embedded once.
BOOKWORMWIKI_EMBEDDING_CACHE=true

# Consolidation Configuration
# Comma-separated, non-root namespaces used by Docker Compose background work.
# The root namespace (/) is rejected so unrelated session memory is not mixed.
BOOKWORMWIKI_CONSOLIDATE_NAMESPACES=/projects

# Number of events to process per consolidation run
BOOKWORMWIKI_CONSOLIDATION_BATCH_SIZE=100

# Similarity threshold for clustering events (0.0 to 1.0)
BOOKWORMWIKI_CONSOLIDATION_SIMILARITY_THRESHOLD=0.85

# Similarity threshold for detecting duplicate facts (0.0 to 1.0)
# Facts with similarity above this threshold are skipped as duplicates
BOOKWORMWIKI_CONSOLIDATION_DEDUP_THRESHOLD=0.85

# Time window for event consolidation (e.g., 168h = 7 days)
BOOKWORMWIKI_CONSOLIDATION_WINDOW=168h

# Optional: Specify custom config file location
# BOOKWORMWIKICONFIG=/path/to/your/.env
